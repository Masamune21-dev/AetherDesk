<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <assemblyIdentity
      type="win32"
      name="id.masamune.AetherDesk.Agent"
      version="0.1.0.0"/>

  <description>AetherDesk — agent remote desktop</description>

  <!-- Berjalan sebagai pengguna biasa, tanpa elevasi.
       Agent menangkap layar sesi interaktif dan menyuntikkan input ke dalamnya;
       keduanya tidak memerlukan hak administrator. Meminta elevasi yang tidak
       dibutuhkan hanya memperbesar akibat bila agent ini disusupi, dan
       memunculkan prompt UAC yang mengajari pengguna menyetujuinya tanpa
       membaca. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Kesadaran DPI dinyatakan di manifest, bukan hanya lewat panggilan saat
       program berjalan.
       Manifest berlaku sebelum satu baris kode pun dieksekusi, sehingga tidak
       ada jendela yang sempat dibuat dalam mode tervirtualisasi lalu berubah.
       Panggilan `SetProcessDpiAwarenessContext` tetap ada sebagai jaring
       pengaman bagi biner yang dijalankan tanpa manifest ini. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <!-- UTF-8 sebagai code page proses: nama berkas dan pesan galat berbahasa
           Indonesia yang memuat karakter non-ASCII tidak lagi bergantung pada
           code page ANSI mesin yang menjalankannya. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>

  <!-- Menyatakan Windows mana yang sudah diuji. Tanpa daftar ini Windows
       menerapkan lapisan kompatibilitas untuk program lawas, dan sebagian API
       melaporkan versi sistem yang keliru. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 dan 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
    </application>
  </compatibility>

  <!-- Common Controls 6: tampilan kontrol sistem mengikuti tema Windows
       modern alih-alih gaya Windows 95. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*"/>
    </dependentAssembly>
  </dependency>

</assembly>
